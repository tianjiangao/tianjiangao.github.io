    "test": "node --test tests/*.test.mjs",
    "check:pages": "node scripts/check-pages.mjs"
  },
  "dependencies": {
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "remark-math": "6.0.0",
    "rehype-katex": "7.0.1",
    "rehype-highlight": "7.0.2",
    "katex": "0.19.0",
    "gray-matter": "4.0.3",
    "@vitejs/plugin-react": "6.0.2",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "typescript": "5.9.3",
    "vite": "8.0.13"
  }
}
